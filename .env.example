# Docker Compose reads .env; direct Python execution does NOT read this file.
# For direct Python, set environment variables in the calling shell.
HUB_PORT=8088
# Empty values generate random keys and persist them in the data directory.
# Never commit real values. Use at least 24 characters when providing a key.
HUB_ADMIN_TOKEN=
HUB_INGEST_TOKEN=
# Set true only when clients connect through trusted same-origin HTTPS.
HUB_SECURE_COOKIE=false
# Process topology, read at service startup; not a cloud-consent switch.
# Use odyssey_openai to detach all PC/Whisper/Qwen/SSH inference paths.
# Existing DB cloud consent is still changed in the manager (see guide below).
HUB_AI_PROFILE=legacy
# Optional absolute codec path, used by odyssey_openai only (no Whisper model).
# HUB_FFMPEG=/usr/bin/ffmpeg
# Python-only settings, not forwarded by the supplied compose.yaml:
# HUB_HOST=0.0.0.0
# HUB_DATA_DIR=/absolute/private/path/room-hub-data
# HUB_WIDGET_DIR=/absolute/path/to/widgets

# --- Optional: OpenAI Personal Agent (Hybrid Tier 0/1/2 Architecture) ---
# Policy seeds only: read when the policy row is first created. After that,
# change the saved policy in the manager UI or PUT /api/agent/budget/policy.
# All three gates (agent + cloud + audio) must be true for OpenAI audio STT;
# a configured key, available budget and verified audio are also required.
# local_only requests never call OpenAI. HUB_LLM_API_KEY is never reused.
# Keep real keys in private process/service environment, never in Git.
# PC-free Odyssey setup: docs/ODYSSEY_OPENAI.md
HUB_PERSONAL_AGENT_ENABLED=false
HUB_OPENAI_ENABLED=false
HUB_OPENAI_AUDIO_ENABLED=false
HUB_OPENAI_ALLOW_SHARED_NOTES=false
OPENAI_API_KEY=
HUB_OPENAI_API_KEY=
HUB_OPENAI_MONTHLY_CAP_USD=100.00
HUB_OPENAI_FAST_MODEL=gpt-6.1-sol
HUB_OPENAI_DEEP_MODEL=gpt-6.1-sol
HUB_OPENAI_REASONING_EFFORT=high
HUB_OPENAI_STT_MODEL=gpt-4o-mini-transcribe
