# Docker Compose reads .env; direct Python execution does NOT read this file.
# For direct Python, set environment variables in the calling shell.
HUB_PORT=8088
# Empty values generate random keys and persist them in the data directory.
# Never commit real values. Use at least 24 characters when providing a key.
HUB_ADMIN_TOKEN=
HUB_INGEST_TOKEN=
# Set true only when clients connect through trusted same-origin HTTPS.
HUB_SECURE_COOKIE=false
# Python-only settings, not forwarded by the supplied compose.yaml:
# HUB_HOST=0.0.0.0
# HUB_DATA_DIR=/absolute/private/path/room-hub-data
# HUB_WIDGET_DIR=/absolute/path/to/widgets
