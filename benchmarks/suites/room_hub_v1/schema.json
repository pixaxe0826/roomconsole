  "expected_fields": {
    "domain": "semantic domain/widget family",
    "capability": "canonical action such as todo.add",
    "slots": "canonical expected slot values",
    "policy": "EXECUTE|CONFIRM|CLARIFY|CANCEL",
    "status": "success|needs_confirmation|needs_clarification|cancelled|unsupported",
    "adapter": "expected adapter family",
    "adapter_should_execute": "whether benchmark sandbox should execute the adapter in this turn",
    "route_hint": "advisory route category; not strict",
    "route_strict": "false in V1",
    "actions": "for multi-intent/cross-widget cases"
  },
  "scoring_recommendation": {
    "primary": [
      "task_success",
      "capability_accuracy",
      "slot_accuracy",
      "policy_accuracy",
      "false_execution_rate"
    ],
    "secondary": [
      "route_distribution",
      "unnecessary_llm_call_rate",
      "latency_ms"
    ],
    "critical_rule": "Any wrong write/control execution should be counted as a critical failure even if intent classification was partially correct."
  },
